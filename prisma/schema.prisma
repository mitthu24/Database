generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COMPANY_ADMIN
  DATA_MANAGER
  DATA_ANALYST
  DATA_ENTRY
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A self-serve "request access" submission from the public marketing site.
// Founder reviews and approves/rejects; approving creates the Company +
// its first COMPANY_ADMIN the same way manual creation does.
model CompanyRequest {
  id          String        @id @default(cuid())
  companyName String
  contactName String
  contactEmail String
  message     String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  decidedAt   DateTime?
}

// The founder/super-admin account(s). Separate from company users entirely.
model Founder {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// A tenant. Founder creates these; gets its own isolated set of users + tables.
model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users  CompanyUser[]
  tables TableDef[]
}

// A user inside a company (data entry / analyst / manager / company admin).
model CompanyUser {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email              String   @unique
  passwordHash       String
  name               String
  role               UserRole
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  createdRows   TableRow[]
  tableAccesses TableAccess[]

  @@index([companyId])
}

// Logical table a company defines through the "Data Ingestion" style UI.
// Columns are stored as a JSON schema; row data lives in TableRow as JSONB.
// This avoids running raw DDL per-tenant while still giving each company
// its own named "tables" with typed columns, exactly like the dataset list
// in the reference screenshots (sp_users, sp_visits, ...).
model TableDef {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  columns   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows     TableRow[]
  accesses TableAccess[]

  @@unique([companyId, slug])
}

// Opt-in per-table restriction for non-manager roles (DATA_ENTRY/DATA_ANALYST).
// A table with zero rows here is open to every active user in the company
// (the Phase 1 default, unchanged); once at least one row exists for a table,
// only COMPANY_ADMIN/DATA_MANAGER plus the listed users can see or act on it.
model TableAccess {
  id        String      @id @default(cuid())
  tableId   String
  table     TableDef    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String
  user      CompanyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([tableId, userId])
  @@index([userId])
}

model TableRow {
  id        String      @id @default(cuid())
  tableId   String
  table     TableDef    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime    @default(now())
  createdById String?
  createdBy CompanyUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tableId])
}

// Audit trail for ingestion actions (replace/append/delete) - phase 1 basic version.
model IngestionLog {
  id        String   @id @default(cuid())
  tableId   String
  action    String // CREATE_TABLE | APPEND | REPLACE | DELETE_ALL_ROWS | DELETE_TABLE | EXPORT
  rowCount  Int?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())
}
