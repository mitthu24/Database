# Postgres connection string from Railway (Project > Postgres > Connect)
DATABASE_URL="postgresql://user:password@host:port/railway"

# Random 32+ char secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Comma separated apex domain(s) used to detect the admin/app subdomains in middleware.
# e.g. if your domain is maindomain.com, admin.maindomain.com -> founder panel,
# app.maindomain.com -> company panel, maindomain.com -> marketing placeholder.
ROOT_DOMAIN="maindomain.com"

# Bootstrap founder account created by prisma/seed.ts (first run only).
FOUNDER_EMAIL="founder@example.com"
FOUNDER_PASSWORD="change-me-now"
